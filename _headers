# The CSP allows only what the pages actually load — check-site's csp gate
# fails the build when the two drift apart in either direction. Two hosts were
# removed 2026-08-18 as dead grants: fonts.googleapis.com / fonts.gstatic.com
# (Inter is self-hosted since the woff2 landed in css/fonts/) and
# static.cloudflareinsights.com (no page ever loaded the beacon).
# challenges.cloudflare.com stays although nothing loads it yet: Turnstile is
# wired end-to-end behind TURNSTILE_REQUIRED and only waits for a site key.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; media-src 'self'; connect-src 'self' https://creativemk.net https://www.creativemk.net https://creative-mk-concierge.arturo-ordonezv.workers.dev https://challenges.cloudflare.com https://connect.facebook.net; frame-src https://challenges.cloudflare.com; form-action 'self' https://formspree.io; upgrade-insecure-requests

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

# Keyed on the URL Pages actually serves, not on the filename. Pages strips
# the .html extension and 308-redirects the old form, so `/contact.html` and
# `/index.html` matched no request at all and both pages silently fell back to
# the platform default (public, max-age=0, must-revalidate).
/contact
  Cache-Control: no-store

/
  Cache-Control: public, max-age=300

# The paid lane stays out of the index. robots.txt deliberately does NOT
# disallow it — a Disallow would prevent Googlebot from reading the page's
# own noindex, which is how ad landing pages end up listed as bare URLs.
# This header says the same thing at the edge, for crawlers that fetch
# before parsing.
/lp/*
  Cache-Control: public, max-age=300
  X-Robots-Tag: noindex, follow

/contact-assets/*
  Cache-Control: public, max-age=31536000, immutable

# images/, Logos/ and video/ are NOT content-hashed, so `immutable` would
# strand every visitor on stale bytes for a year — surviving even a hard
# reload and a zone purge. They revalidate instead until the fingerprint pass
# learns to rewrite src/srcset.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/Logos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Two tiers share these directories. The content-hashed copies are immutable
# by construction, but a glob cannot say so without also freezing the un-hashed
# originals that HTML cached for up to five minutes still references — so the
# glob carries the short TTL, and scripts/fingerprint.mjs appends a per-file
# immutable rule for every hashed name it mints (last matching rule wins).
/css/*
  Cache-Control: public, max-age=3600

/js/*
  Cache-Control: public, max-age=3600
