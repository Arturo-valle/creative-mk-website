{
  "name": "creative-mk-contact-page",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:contact && node scripts/build-pages.mjs",
    "dev:contact": "vite --host 127.0.0.1",
    "build:contact": "vite build && node scripts/copy-contact-build.mjs",
    "preview:contact": "vite preview --host 127.0.0.1",
    "typecheck": "wrangler types cloudflare/agent/worker-configuration.d.ts --config cloudflare/agent/wrangler.jsonc && tsc -p cloudflare/agent/tsconfig.json",
    "check:site": "node scripts/check-site.mjs",
    "verify": "npm run build && npm run typecheck && npm run check:site"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "agents": "^0.14.1",
    "autoprefixer": "^10.4.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "ogl": "^1.0.11",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.97.0"
  }
}
