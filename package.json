{
  "name": "creative-mk-contact-page",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:contact && node scripts/copy-assets.mjs && npx @11ty/eleventy && node scripts/fingerprint.mjs && node scripts/audit.mjs --emit .audit.json && node scripts/colophon.mjs && node scripts/audit-history.mjs && node scripts/check-site.mjs",
    "dev:contact": "vite --host 127.0.0.1",
    "build:contact": "vite build && node scripts/copy-contact-build.mjs",
    "preview:contact": "vite preview --host 127.0.0.1",
    "typecheck": "wrangler types cloudflare/agent/worker-configuration.d.ts --config cloudflare/agent/wrangler.jsonc && tsc -p cloudflare/agent/tsconfig.json",
    "check:site": "node scripts/check-site.mjs",
    "verify": "npm run build && npm run test:i18n && npm run measure:bilingual && npm run typecheck && npm run check:site && npm run audit:deps",
    "audit:deps": "npm audit --audit-level=high",
    "audit": "node scripts/audit.mjs",
    "test:i18n": "node scripts/test-i18n-gate.mjs",
    "measure:bilingual": "node scripts/measure-bilingual.mjs",
    "shoot": "node scripts/shoot.mjs",
    "diff:visual": "node scripts/visual-diff.mjs",
    "axe": "node scripts/axe-pass.mjs",
    "check:live": "node scripts/check-live.mjs",
    "frame:cost": "node scripts/frame-cost.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "agents": "^0.14.1",
    "autoprefixer": "^10.4.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "ogl": "^1.0.11",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@axe-core/playwright": "^4.13.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "wrangler": "^4.97.0"
  }
}
