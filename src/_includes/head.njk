{#- The one <head> for every hand-authored page. Front matter supplies title,
    description, canonical (path only) and either `schema` (an object, the
    preferred form) or `jsonld` (a pre-rendered string, legacy). Everything
    else — the stylesheet cascade, the font preload, the reveal bootstrap — is
    shared so it can never drift between pages again.

    Values are escaped exactly once, through the `attr` filter, because
    Nunjucks' autoescaping would otherwise run a second pass over an already
    escaped entity and ship &amp;amp; in a title. -#}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | attr | safe }}</title>
  <meta name="description" content="{{ description | attr | safe }}">
  <meta property="og:title" content="{{ (ogTitle or title) | attr | safe }}">
  <meta property="og:description" content="{{ (ogDescription or description) | attr | safe }}">
  {#- og:type was hardcoded to "website" on every URL, including the notes,
      so a shared article never announced itself as one. -#}
  <meta property="og:type" content="{{ 'article' if ogType == 'article' else 'website' }}">
{%- if ogType == 'article' and articlePublished %}
  <meta property="article:published_time" content="{{ articlePublished }}">
  <meta property="article:author" content="Arturo Valle">
{%- endif %}
  <meta property="og:url" content="{{ site.origin }}{{ canonical }}">
  <meta property="og:site_name" content="CREATIVE MK">
  {#- Per-page cards (scripts/og-cards.mjs). Every URL used to share the raw
      5000x3068 brand PNG, so every link shared to WhatsApp — the channel
      this market actually uses — was the same black rectangle. -#}
  <meta property="og:image" content="{{ site.origin }}{{ ogImage or site.defaultOgImage }}">
{%- if ogImage %}
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
{%- endif %}
  <meta property="og:image:alt" content="{{ (ogTitle or title) | attr | safe }}">
  <meta property="og:locale" content="{{ 'es_ES' if lang == 'es' else 'en_US' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ (ogTitle or title) | attr | safe }}">
  <meta name="twitter:description" content="{{ (ogDescription or description) | attr | safe }}">
  <meta name="twitter:image" content="{{ site.origin }}{{ ogImage or site.defaultOgImage }}">
  <link rel="canonical" href="{{ site.origin }}{{ canonical }}">
{#- hreflang. Two ways in: the legacy `hreflang` list (the privacy pair set
    it by hand), or the `altEn`/`altEs` pair a locale template computes.
    Google requires the set to be identical on both sides, self-referencing
    and bidirectional — an asymmetric cluster is ignored wholesale — so the
    triplet is emitted from one place with x-default pointing at English. -#}
{%- if altEn or altEs %}
{%- set enHref = altEn if altEn else canonical %}
{%- set esHref = altEs if altEs else canonical %}
  <link rel="alternate" hreflang="en" href="{{ site.origin }}{{ enHref }}">
  <link rel="alternate" hreflang="es" href="{{ site.origin }}{{ esHref }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.origin }}{{ enHref }}">
{%- elif hreflang %}
{%- for alt in hreflang %}
  <link rel="alternate" hreflang="{{ alt.lang }}" href="{{ site.origin }}{{ alt.href }}">
{%- endfor %}
{%- endif %}
{%- if robots %}
  <meta name="robots" content="{{ robots }}">
{%- endif %}
{#- Preferred: a `schema` object serialised by the jsonld filter, always
    wrapped in a @graph that carries the studio stub, so the {"@id": …#studio}
    references every page makes actually resolve inside its own document. -#}
{%- if pageSchema %}
  <script type="application/ld+json">
{#- The @id is page-scoped. It used to be hardcoded to "/#faq", which was
    harmless while one document carried an FAQ and became a collision the day
    /es/ shipped: two pages declaring the same node with different questions. -#}
{%- set faqNode = { "@type": "FAQPage", "@id": site.origin + page.url + "#faq", "mainEntity": faqEntities } -%}
{#- A service page declares its OWN questions, built from the same array it
    renders, so the schema can never promise a question the page does not
    show — the failure the audit found on the homepage, where FAQPage was
    declared over a section JS had not filled yet. -#}
{%- set serviceFaqNode = { "@type": "FAQPage", "@id": site.origin + page.url + "#faq", "mainEntity": serviceFaqEntities } -%}
{%- set graph = [(schema.studioFull if (page.url == "/" or page.url == "/es/") else schema.studio), pageSchema] -%}
{%- if extraSchema == "faq" %}{% set graph = graph | concat([faqNode]) %}{% endif -%}
{%- if extraSchema == "serviceFaq" and serviceFaqEntities %}{% set graph = graph | concat([serviceFaqNode]) %}{% endif -%}
{%- if breadcrumbEntities %}{% set graph = graph | concat([breadcrumbEntities]) %}{% endif -%}
{%- if collectionListSchema %}{% set graph = graph | concat([collectionListSchema]) %}{% endif -%}
{{ { "@context": "https://schema.org", "@graph": graph } | jsonld | safe }}
  </script>
{%- elif jsonld %}
  <script type="application/ld+json">
{{ jsonld | safe }}
  </script>
{%- endif %}
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/favicon.png">
  <link rel="preload" href="/css/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin>
  {#- Order is the cascade. clay-refresh overrides the section files, stage
      overrides the section backgrounds clay-refresh set; the concierge comes
      last. Do not reorder. -#}
  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/sections.css">
  <link rel="stylesheet" href="/css/clay-refresh.css">
  <link rel="stylesheet" href="/css/stage.css">
{%- if subpage %}
  <link rel="stylesheet" href="/css/subpage.css">
{%- endif %}
  <link rel="stylesheet" href="/css/ai-concierge.css">
{#- Per-page sheets, last in the cascade. /privacidad/ needs css/lp.css because
    its body is lp-namespaced markup: without this the page renders with none
    of its own classes defined — a live regression the Phase 0 validation
    caught before it shipped. -#}
{%- for sheet in extraCss %}
  <link rel="stylesheet" href="{{ sheet }}">
{%- endfor %}
{#- Reveal bootstrap. `.js-reveal` is the only thing that hides the `.reveal`
    blocks; css/base.css never hides them on its own. Adding it here — after the
    stylesheets, so they are discovered first, and still before the first paint
    — means nothing flashes in and then vanishes. Removing it again on `load`
    when js/animations.js has not claimed it means a blocked or broken script
    leaves a readable page. Keep it inline: an external file could be the thing
    that fails. -#}
  <script>
    (function () {
      var root = document.documentElement;
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      root.classList.add('js-reveal');
      root.classList.add('js-arrival');
      window.addEventListener('load', function () {
        if (root.dataset.revealReady !== 'true') root.classList.remove('js-reveal');
        if (root.dataset.arrivalReady !== 'true') root.classList.remove('js-arrival');
      });
    })();
  </script>
