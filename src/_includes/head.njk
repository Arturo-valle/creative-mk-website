{#- The one <head> for every hand-authored page. Front matter supplies title,
    description, canonical (path only) and either `schema` (an object, the
    preferred form) or `jsonld` (a pre-rendered string, legacy). Everything
    else — the stylesheet cascade, the font preload, the reveal bootstrap — is
    shared so it can never drift between pages again.

    Values are escaped exactly once, through the `attr` filter, because
    Nunjucks' autoescaping would otherwise run a second pass over an already
    escaped entity and ship &amp;amp; in a title. -#}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | attr | safe }}</title>
  <meta name="description" content="{{ description | attr | safe }}">
  <meta property="og:title" content="{{ (ogTitle or title) | attr | safe }}">
  <meta property="og:description" content="{{ (ogDescription or description) | attr | safe }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.origin }}{{ canonical }}">
  <meta property="og:site_name" content="CREATIVE MK">
  <meta property="og:image" content="{{ site.origin }}{{ ogImage or site.defaultOgImage }}">
  <meta property="og:image:alt" content="CREATIVE MK">
  <meta property="og:locale" content="{{ 'es_ES' if lang == 'es' else 'en_US' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ (ogTitle or title) | attr | safe }}">
  <meta name="twitter:description" content="{{ (ogDescription or description) | attr | safe }}">
  <meta name="twitter:image" content="{{ site.origin }}{{ ogImage or site.defaultOgImage }}">
  <link rel="canonical" href="{{ site.origin }}{{ canonical }}">
{%- if hreflang %}
{%- for alt in hreflang %}
  <link rel="alternate" hreflang="{{ alt.lang }}" href="{{ site.origin }}{{ alt.href }}">
{%- endfor %}
{%- endif %}
{%- if robots %}
  <meta name="robots" content="{{ robots }}">
{%- endif %}
{#- Preferred: a `schema` object serialised by the jsonld filter, always
    wrapped in a @graph that carries the studio stub, so the {"@id": …#studio}
    references every page makes actually resolve inside its own document. -#}
{%- if pageSchema %}
  <script type="application/ld+json">
{%- set faqNode = { "@type": "FAQPage", "@id": site.origin + "/#faq", "mainEntity": faqEntities } -%}
{%- set graph = [(schema.studioFull if page.url == "/" else schema.studio), pageSchema] -%}
{%- if extraSchema == "faq" %}{% set graph = graph | concat([faqNode]) %}{% endif -%}
{{ { "@context": "https://schema.org", "@graph": graph } | jsonld | safe }}
  </script>
{%- elif jsonld %}
  <script type="application/ld+json">
{{ jsonld | safe }}
  </script>
{%- endif %}
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/favicon.png">
  <link rel="preload" href="/css/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin>
  {#- Order is the cascade. clay-refresh overrides the section files, stage
      overrides the section backgrounds clay-refresh set; the concierge comes
      last. Do not reorder. -#}
  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/sections.css">
  <link rel="stylesheet" href="/css/clay-refresh.css">
  <link rel="stylesheet" href="/css/stage.css">
{%- if subpage %}
  <link rel="stylesheet" href="/css/subpage.css">
{%- endif %}
  <link rel="stylesheet" href="/css/ai-concierge.css">
{#- Per-page sheets, last in the cascade. /privacidad/ needs css/lp.css because
    its body is lp-namespaced markup: without this the page renders with none
    of its own classes defined — a live regression the Phase 0 validation
    caught before it shipped. -#}
{%- for sheet in extraCss %}
  <link rel="stylesheet" href="{{ sheet }}">
{%- endfor %}
{#- Reveal bootstrap. `.js-reveal` is the only thing that hides the `.reveal`
    blocks; css/base.css never hides them on its own. Adding it here — after the
    stylesheets, so they are discovered first, and still before the first paint
    — means nothing flashes in and then vanishes. Removing it again on `load`
    when js/animations.js has not claimed it means a blocked or broken script
    leaves a readable page. Keep it inline: an external file could be the thing
    that fails. -#}
  <script>
    (function () {
      var root = document.documentElement;
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      root.classList.add('js-reveal');
      root.classList.add('js-arrival');
      window.addEventListener('load', function () {
        if (root.dataset.revealReady !== 'true') root.classList.remove('js-reveal');
        if (root.dataset.arrivalReady !== 'true') root.classList.remove('js-arrival');
      });
    })();
  </script>
