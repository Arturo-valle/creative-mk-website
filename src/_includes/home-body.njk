{#- The homepage body, built once and served in two languages.

    Every string comes from src/_data/homeCopy.js; every route is chosen by
    `L`. The data-i18n attributes stay exactly where they were, because the
    in-page EN/ES toggle still has to work for a visitor who switches without
    navigating — but they are now an enhancement over a document that is
    already in the right language, instead of the only thing that makes it so.

    Before this file, `/es/` could not exist: the Spanish homepage was an
    English document that rewrote itself after load, which a crawler never
    sees. That left the site's strongest page outside the language graph and
    seventeen Spanish URLs with no crawlable path from the front door. -#}

{%- set t = homeCopy[L or "en"] %}
{%- set isEs = (L == "es") %}
{%- set urlServices = "/es/servicios/" if isEs else "/services/" %}
{%- set urlWork = "/es/trabajo/" if isEs else "/work/" %}
{%- set urlStudio = "/es/estudio/" if isEs else "/studio/" %}
{%- set urlNotes = "/es/notas/" if isEs else "/insights/" %}

  <!-- ========== HERO ========== -->
  <!-- The hero's private canvas is gone: the terrain lives on the page-wide
       canvas now (js/terrain.js) and persists through all three acts. -->
  <section class="hero section" id="hero">
    <div class="container hero__container">
      <!-- No .reveal above the fold: the hero must never wait for an observer.
           Its choreography arrives with the phase-2 arrival timeline. -->
      <div class="hero__text">
        <span class="hero__eyebrow" data-i18n="hero.eyebrow">{{ t.hero.eyebrow }}</span>
        <h1 class="hero__title" id="hero-title" data-i18n="hero.title">
          {{ t.hero.title }}
        </h1>
        <p class="hero__lede" data-i18n="hero.lede">
          {{ t.hero.lede }}
        </p>
        <div class="hero__actions" aria-label="{{ "Acciones principales" if isEs else "Primary actions" }}">
          <a href="/contact" class="hero__cta" data-i18n="hero.primaryCta">{{ t.hero.primaryCta }}</a>
          <a href="{{ urlServices }}" class="hero__link" data-i18n="hero.secondaryCta">{{ t.hero.secondaryCta }}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== SHOWREEL ==========
       The frame is full-bleed in layout; js/daylight.js insets it with
       clip-path to the rail's width and one scrub expands it to the edges as
       it enters — clip, not layout, so no pinning and no scroll hijack
       (immersive-plan §5). The rail above gives the reel authorship: the
       title made visible, and a real timecode written from timeupdate. -->
  <section class="showreel section" id="showreel">
    <div class="container showreel__rail">
      <h2 class="showreel__title" data-i18n="showreel.title">{{ t.showreel.title }}</h2>
      <span class="showreel__timecode" id="showreel-timecode" aria-hidden="true">0:00 / 0:00</span>
    </div>
    <div class="showreel__stage">
      <div class="showreel__frame">
        <video
          class="hero__video"
          id="hero-video"
          autoplay
          loop
          muted
          playsinline
          preload="none"
          {#- Root-relative, not relative. These were "video/..." — correct on
              / and a 404 on /es/, where they resolved to /es/video/. They are
              data- attributes assigned to video.src by js/main.js, so neither
              the HTML parser nor check-site.mjs's href/src scan ever saw them;
              the Spanish showreel simply failed to load. scripts/check-site.mjs
              now validates these attributes too. -#}
          data-src-desktop="{{ home }}video/creative-mk-hero-desktop-sound.mp4"
          data-src-mobile="{{ home }}video/creative-mk-hero-mobile-sound.mp4"
          data-av1-desktop="{{ home }}video/creative-mk-hero-desktop-av1.mp4"
          data-av1-mobile="{{ home }}video/creative-mk-hero-mobile-av1.mp4">
        </video>
        <button class="hero__play-btn" id="hero-play-btn" type="button" aria-label="{{ t.hero.soundEnable }}" aria-pressed="false">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
          <span data-i18n="hero.soundEnable">{{ t.hero.soundEnable }}</span>
        </button>
      </div>
    </div>
  </section>

  <!-- ========== PROOF / POSITIONING ==========
       Sits below the showreel so the hero and the reel form one contiguous
       dark act; this strip is where the lights have come up (immersive-plan
       §0). It opens the daylight act as the first ruled ledger. -->
  <section class="proof section" id="proof">
    <div class="container">
      <div class="proof__intro reveal">
        <span class="section-kicker" data-i18n="proof.kicker">{{ t.proof.kicker }}</span>
        <h2 class="proof__title" data-i18n="proof.title">{{ t.proof.title }}</h2>
        <p class="proof__text" data-i18n="proof.text">{{ t.proof.text }}</p>
      </div>
      <!-- The first ledger (immersive-plan §4). Labels translate; the figure
           lives outside data-i18n so no dictionary swap can ever rewrite it.
           The "2" is the same number js/main.js publishes in the work ledger —
           the two sections corroborate each other, so change both or neither. -->
      <div class="proof__grid reveal reveal-delay-1" aria-label="{{ "Señales de confianza de CREATIVE MK" if isEs else "CREATIVE MK trust signals" }}">
        <article class="proof__item" style="--i:0">
          <span data-i18n="proof.itemOneLabel">{{ t.proof.itemOneLabel }}</span>
          <strong data-i18n="proof.itemOneValue">{{ t.proof.itemOneValue }}</strong>
        </article>
        <article class="proof__item" style="--i:1">
          <span data-i18n="proof.itemTwoLabel">{{ t.proof.itemTwoLabel }}</span>
          <strong data-i18n="proof.itemTwoValue">{{ t.proof.itemTwoValue }}</strong>
        </article>
        <article class="proof__item" style="--i:2">
          <span data-i18n="proof.itemThreeLabel">{{ t.proof.itemThreeLabel }}</span>
          <strong><a href="{{ urlWork }}" class="proof__count"><span class="proof__digit">2</span></a></strong>
        </article>
        <article class="proof__item" style="--i:3">
          <span data-i18n="proof.itemFourLabel">{{ t.proof.itemFourLabel }}</span>
          <strong data-i18n="proof.itemFourValue">{{ t.proof.itemFourValue }}</strong>
        </article>
      </div>
    </div>
  </section>

  <!-- ========== CAPABILITIES / SERVICES ========== -->
  <section class="capabilities section" id="capabilities">
    <div class="container">
      <div class="section-heading reveal">
        <span class="section-kicker" data-i18n="capabilities.kicker">{{ t.capabilities.kicker }}</span>
        <h2 class="section-title" data-i18n="capabilities.title">{{ t.capabilities.title }}</h2>
      </div>
      <div class="capabilities__layout">
        <p class="capabilities__intro reveal" data-i18n="capabilities.intro">
          {{ t.capabilities.intro }}
        </p>
        <!-- Two stacked layers so the image swap can wipe directionally
             (immersive-plan §6): the hidden layer receives the incoming
             sources, decodes, and clip-path reveals it from the direction of
             travel. Layer roles are tracked in data-front / data-current. -->
        <div class="capabilities__visual" id="capabilities-visual" data-front="0" data-current="0">
          <div class="cap-stack">
            <picture class="cap-layer">
              <source type="image/avif" sizes="(max-width: 1024px) 100vw, 45vw" srcset="{{ home }}images/services/web-design-480.avif 480w, {{ home }}images/services/web-design-960.avif 960w">
              <source type="image/webp" sizes="(max-width: 1024px) 100vw, 45vw" srcset="{{ home }}images/services/web-design-480.webp 480w, {{ home }}images/services/web-design-960.webp 960w">
              <img src="{{ home }}images/services/web-design.jpg" alt="{{ t.servicePreviewAlt }}" loading="lazy" decoding="async" width="960" height="960">
            </picture>
            <picture class="cap-layer" aria-hidden="true">
              <source type="image/avif" sizes="(max-width: 1024px) 100vw, 45vw" srcset="">
              <source type="image/webp" sizes="(max-width: 1024px) 100vw, 45vw" srcset="">
              <img src="{{ home }}images/services/web-design.jpg" alt="" loading="lazy" decoding="async" width="960" height="960">
            </picture>
          </div>
        </div>
        <div class="capabilities__list" id="capabilities-list" role="region" aria-label="{{ "Servicios" if isEs else "Services" }}">
          <!-- Items generated by JS -->
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PROCESS ========== -->
  <section class="process section" id="process">
    <div class="container">
      <div class="section-heading reveal">
        <span class="section-kicker" data-i18n="process.kicker">{{ t.process.kicker }}</span>
        <h2 class="section-title" data-i18n="process.title">{{ t.process.title }}</h2>
      </div>
      <!-- The line that draws the method (immersive-plan §7). js/daylight.js
           lays one SVG over the grid — a navy trail with a gold tip, scrubbed
           by scroll — and re-measures it on resize and on every EN/ES swap.
           Without JS the steps keep their border-top and solid numbers. -->
      <div class="process__grid reveal reveal-delay-1" id="process-grid">
        {%- set stepKeys = ["One", "Two", "Three", "Four"] %}
        {%- for step in t.process.steps %}
        <article class="process__step">
          <span>0{{ loop.index }}</span>
          <h3 data-i18n="process.step{{ stepKeys[loop.index0] }}Title">{{ step.title }}</h3>
          <p data-i18n="process.step{{ stepKeys[loop.index0] }}Text">{{ step.text }}</p>
          <span class="process__step-meta" data-i18n="process.step{{ stepKeys[loop.index0] }}Meta">{{ step.meta }}</span>
        </article>
        {%- endfor %}
      </div>
    </div>
  </section>

  <!-- ========== AI AUTOMATION ========== -->
  <section class="ai-automation section" id="ai-automation">
    <div class="container">
      <div class="ai-automation__card reveal">
        <div class="ai-automation__content">
          <span class="ai-automation__label" data-i18n="ai.label">{{ t.ai.label }}</span>
          <h2 class="ai-automation__title" data-i18n="ai.title">{{ t.ai.title }}</h2>
          <p class="ai-automation__text" data-i18n="ai.text">{{ t.ai.text }}</p>
          <a href="/contact" class="ai-automation__cta" data-i18n="ai.cta">{{ t.ai.cta }}</a>
          <button class="ai-concierge-inline" type="button" data-mk-concierge-trigger data-mode="diagnostic">
            <span class="ai-concierge-inline__eyebrow">{{ t.ai.conciergeEyebrow }}</span>
            <span class="ai-concierge-inline__text">{{ t.ai.conciergeText }}</span>
          </button>
        </div>
        <!-- The workflow trace (immersive-plan §10): a drawing of the intake
             pipeline that actually powers the concierge, not statistic tiles.
             Geometry is SVG; the labels are HTML with data-i18n so language
             and geometry never touch. The spine ends at the concierge trigger
             in the left column — the diagram's endpoint is a working demo. -->
        <div class="ai-automation__visual">
          <div class="ai-automation__trace" id="ai-trace">
            <svg class="ai-trace__svg" viewBox="0 0 48 220" aria-hidden="true" focusable="false">
              <line class="ai-trace__rail" x1="24" y1="18" x2="24" y2="202"/>
              <path class="ai-trace__path" id="ai-trace-path" d="M24 18 V202" pathLength="1"/>
              <circle class="ai-trace__node" cx="24" cy="24" r="5"/>
              <circle class="ai-trace__node" cx="24" cy="82" r="5"/>
              <circle class="ai-trace__node" cx="24" cy="140" r="5"/>
              <circle class="ai-trace__node" cx="24" cy="198" r="5"/>
            </svg>
            <div class="ai-trace__labels">
              {%- set traceKeys = ["Intake", "Match", "Response", "Handoff"] %}
              {%- for label in t.ai.trace %}
              <span class="ai-trace__label" data-i18n="ai.trace{{ traceKeys[loop.index0] }}">{{ label }}</span>
              {%- endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WORK / PORTFOLIO ========== -->
  <section class="work section" id="work">
    <div class="container">
      <div class="work__header reveal">
        <div>
          <span class="section-kicker" data-i18n="work.kicker">{{ t.work.kicker }}</span>
          <h2 class="work__title" data-i18n="work.title">{{ t.work.title }}</h2>
        </div>
        <a href="{{ urlWork }}" class="link-arrow" data-i18n="work.viewAll">{{ t.work.viewAll }}</a>
      </div>
      {#- The two published cases, rendered at build time so they exist for a
          crawler and navigate for a visitor. The JS ledger renders below them
          and keeps stating what cannot be proven yet. -#}
      <div class="workplates">
        {%- for case in cases %}
        {%- set c = case.es if isEs else case.en %}
        <a class="workplate reveal" href="{{ urlWork }}{{ case.esSlug if isEs else case.slug }}/">
          <span class="workplate__index" aria-hidden="true">0{{ loop.index }}</span>
          <span class="workplate__title">{{ c.title }}</span>
          <span class="workplate__lead"><span data-i18n="workPage.selfLabel">{{ t.work.selfLabel }}</span> &middot; {{ c.lead }}</span>
          <span class="workplate__figure"><strong>{{ c.figure }}</strong> {{ c.figureLabel }}</span>
        </a>
        {%- endfor %}
      </div>
      <div class="work__grid" id="work-grid">
        <!-- Ledger generated by JS -->
      </div>
    </div>
  </section>

  <!-- ========== ABOUT ========== -->
  <section class="about section" id="about">
    <div class="container">
      <div class="about__content reveal">
        <h2 class="about__title" data-i18n="about.title">{{ t.about.title }}</h2>
        <div>
          <p class="about__text" data-i18n="about.text">{{ t.about.text }}</p>
          <a href="{{ urlStudio }}" class="link-arrow" data-i18n="about.viewServices">{{ t.about.viewServices }}</a>
        </div>
      </div>
    </div>
    <!-- The stock "team" carousel is gone: six strangers' photos two sections
         above a ledger that says "Team: 1" was the page's loudest honesty
         contradiction. The section returns as an artifacts shelf when real
         artifacts exist (immersive-plan §9). -->
    <div class="container">
      <div class="about__bottom reveal">
        <p class="about__bottom-text" data-i18n="about.bottomText">{{ t.about.bottomText }}</p>
        <a href="{{ urlStudio }}" class="link-arrow" data-i18n="about.learnMore">{{ t.about.learnMore }}</a>
      </div>
    </div>
  </section>

  <!-- ========== INSIGHTS ==========
       Rendered at build time from src/_data/notes.js — the same source the
       /insights/ pages use, so the homepage can never again carry an older
       draft of an article that exists elsewhere, or a read time the text does
       not support. The modal machinery is gone: these are links. -->
  <section class="news section" id="news">
    <div class="container">
      <div class="news__header reveal">
        <h2 class="news__title" data-i18n="news.title">{{ t.news.title }}</h2>
        <a href="{{ urlNotes }}" class="link-arrow text-white" data-i18n="news.visitBlog">{{ t.news.visitBlog }}</a>
      </div>
      <div class="news__grid" id="news-grid">
        {%- for note in notes %}
        {%- set n = note.es if isEs else note.en %}
        <a class="newscard reveal" href="{{ urlNotes }}{{ note.esSlug if isEs else note.slug }}/">
          <span class="newscard__meta">
            <span>{{ n.category }}</span>
            <span aria-hidden="true">&middot;</span>
            <span>{{ n.date }}</span>
            <span aria-hidden="true">&middot;</span>
            <span>{{ note.minutes }} min</span>
          </span>
          <span class="newscard__title">{{ n.title }}</span>
        </a>
        {%- endfor %}
      </div>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="faq section" id="faq">
    <div class="container">
      <div class="faq__header reveal">
        <h2 class="faq__title" data-i18n="faq.title">{{ t.faq.title }}</h2>
      </div>
      <div class="faq__list" id="faq-list" role="region" aria-label="FAQ">
        <!-- FAQ items generated by JS -->
      </div>
    </div>
  </section>

  {#- The JSON island js/main.js renders the accordion and FAQ from — the
      same src/_data bytes the service pages are built with, so the homepage
      and its pages cannot drift apart. The jsonld filter escapes `<`, which
      is the one sequence that could close this element early. -#}
  <script type="application/json" id="mk-data">{{ mkIsland | jsonld | safe }}</script>
