  altEn: "/services/{{ service.slug }}/"
  pageSchema:
    "@type": "Service"
    "@id": "https://creativemk.net/es/servicios/{{ service.esSlug }}/#service"
    name: "{{ service.es.title | safe }}"
    url: "https://creativemk.net/es/servicios/{{ service.esSlug }}/"
    serviceType: "{{ service.es.lead | safe }}"
    description: "{{ service.es.desc | safe }}"
    provider:
      "@id": "https://creativemk.net/#studio"
    areaServed: "Worldwide"
    availableLanguage: ["es", "en"]
