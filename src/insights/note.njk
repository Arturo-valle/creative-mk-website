---
pagination:
  data: notes
  size: 1
  alias: note
permalink: "/insights/{{ note.slug }}/"
layout: "layout.njk"
subpage: true
eleventyComputed:
  title: "{{ note.en.title }} | CREATIVE MK"
  description: "{{ note.en.content | truncate(155) }}"
  ogDescription: "{{ note.en.title }} — a short note from CREATIVE MK."
  canonical: "/insights/{{ note.slug }}/"
  jsonld: |
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "{{ note.en.title }}",
      "url": "https://creativemk.net/insights/{{ note.slug }}/",
      "datePublished": "{{ note.en.date }}",
      "wordCount": {{ note.words }},
      "inLanguage": "en",
      "author": { "@type": "Person", "name": "Arturo Valle" },
      "publisher": { "@id": "https://creativemk.net/#studio" }
    }
---
    <div class="container">
      <article class="note">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/insights/" data-i18n="insightsPage.kicker">Insights</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ note.en.category }}</span>
        </nav>

        <h1 class="subpage__title note__title">{{ note.en.title }}</h1>

        {#- The read time is derived from the real word count at 230 wpm, so it
            can never drift from the text. These used to claim "6 min" over
            ninety words. -#}
        <p class="note__meta">
          <span>{{ note.en.date }}</span>
          <span aria-hidden="true">·</span>
          <span>{{ note.minutes }} min</span>
          <span aria-hidden="true">·</span>
          <span>Arturo Valle</span>
        </p>

        <div class="note__body">
          {%- for para in note.paragraphs.en %}
          <p>{{ para }}</p>
          {%- endfor %}
        </div>

        <aside class="note__cta">
          <p data-i18n="insightsPage.ctaText">Notes are short on purpose. The long version happens in a project.</p>
          <a class="link-arrow" href="/contact.html" data-i18n="hero.primaryCta">Start a project</a>
        </aside>

        <nav class="note__siblings" aria-label="More notes">
          <h2 class="svc__block-title" data-i18n="insightsPage.moreTitle">More notes</h2>
          <ul>
            {%- for other in notes %}{% if other.slug != note.slug %}
            <li><a href="/insights/{{ other.slug }}/">{{ other.en.title }}</a></li>
            {%- endif %}{% endfor %}
          </ul>
        </nav>
      </article>
    </div>
