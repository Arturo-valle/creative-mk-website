---
pagination:
  data: services
  size: 1
  alias: service
permalink: "/services/{{ service.slug }}/"
layout: "layout.njk"
subpage: true
eleventyComputed:
  title: "{{ service.en.title | safe }} | CREATIVE MK"
  description: "{{ service.en.desc | truncate(155) }}"
  ogDescription: "{{ service.en.lead | safe }} — {{ service.en.title | safe }} at CREATIVE MK."
  canonical: "/services/{{ service.slug }}/"
  pageSchema:
    "@type": "Service"
    "@id": "https://creativemk.net/services/{{ service.slug }}/#service"
    name: "{{ service.en.title | safe }}"
    url: "https://creativemk.net/services/{{ service.slug }}/"
    serviceType: "{{ service.en.lead | safe }}"
    description: "{{ service.en.desc | safe }}"
    provider:
      "@id": "https://creativemk.net/#studio"
    areaServed: "Worldwide"
    availableLanguage: ["en", "es"]
  extraSchema: "serviceFaq"
---
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/services/" data-i18n="servicesPage.kicker">Services</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ service.en.title }}</span>
      </nav>

      <span class="section-kicker" data-fx="fade-up">{{ service.en.lead }}</span>
      <h1 class="subpage__title" data-fx="lines">{{ service.en.title }}</h1>
      <p class="subpage__lede" data-fx="fade-up" data-fx-delay="0.15">{{ service.en.desc }}</p>

      {#- The service image. It shipped in the repo, sized and converted to
          AVIF/WebP, and was used only by the homepage accordion — so every
          service page was typography on an empty canvas while its own
          picture sat in dist/. The torch mask (css/subpage.css) is the
          non-GL tier of the site's motion language: it works on mobile and
          on software renderers, where the field cannot run. -#}
      {%- set imgBase = service.media | replace(".jpg", "") %}
      <figure class="svc__figure" data-fx="fade-up" data-fx-delay="0.2">
        <picture>
          <source type="image/avif" srcset="/{{ imgBase }}-480.avif 480w, /{{ imgBase }}-960.avif 960w" sizes="(max-width: 900px) 100vw, 860px">
          <source type="image/webp" srcset="/{{ imgBase }}-480.webp 480w, /{{ imgBase }}-960.webp 960w" sizes="(max-width: 900px) 100vw, 860px">
          <img src="/{{ service.media }}" alt="{{ service.en.title }} work at CREATIVE MK" loading="lazy" decoding="async" width="960" height="960">
        </picture>
      </figure>

      {#- The page's own argument. Until 2026-08-13 the whole body was the
          desc above plus one sentence, all of it already visible in the
          homepage accordion — which is why a click into a service delivered
          deja vu. Everything from here down exists only on this URL. -#}
      <div class="svc__intro" data-fx="fade-up">
        {%- for para in service.en.intro %}
        <p>{{ para }}</p>
        {%- endfor %}
      </div>

      <section class="svc__block" aria-labelledby="svc-fit">
        <h2 id="svc-fit" class="svc__block-title" data-fx="fade-up" data-i18n="servicePage.fitTitle">Who this is for</h2>
        <p class="svc__proof" data-fx="fade-up">{{ service.en.proof }}</p>
      </section>

      <section class="svc__block" aria-labelledby="svc-what">
        <h2 id="svc-what" class="svc__block-title" data-fx="fade-up" data-i18n="servicePage.whatTitle">What it covers</h2>
        <ul class="svc__tags" data-fx="group">
          {%- for tag in service.en.tags %}
          <li>{{ tag }}</li>
          {%- endfor %}
        </ul>
      </section>

      {#- Deliverables as artifacts, not adjectives: what actually arrives. -#}
      <section class="svc__block" aria-labelledby="svc-deliverables">
        <h2 id="svc-deliverables" class="svc__block-title" data-fx="fade-up" data-i18n="servicePage.deliverablesTitle">What you get</h2>
        <dl class="svc__deliverables" data-fx="group">
          {%- for item in service.en.deliverables %}
          <div class="svc__deliverable">
            <dt>{{ item.name }}</dt>
            <dd>{{ item.detail }}</dd>
          </div>
          {%- endfor %}
        </dl>
      </section>

      {#- Engagement shapes with the published duration ranges. Nothing here
          is a package and no price is quoted; the shape is what lets a buyer
          self-qualify before a call, which is the step the audit found
          missing. -#}
      <section class="svc__block" aria-labelledby="svc-shapes">
        <h2 id="svc-shapes" class="svc__block-title" data-fx="fade-up" data-i18n="servicePage.shapesTitle">Ways to start</h2>
        <ul class="svc__shapes" data-fx="group">
          {%- for item in service.en.engagements %}
          <li class="svc__shape">
            <h3 class="svc__shape-name">{{ item.name }}</h3>
            <p class="svc__shape-duration">{{ item.duration }}</p>
            <p class="svc__shape-includes">{{ item.includes }}</p>
          </li>
          {%- endfor %}
        </ul>
      </section>

      <section class="svc__block" aria-labelledby="svc-how">
        <h2 id="svc-how" class="svc__block-title" data-fx="fade-up" data-i18n="servicePage.howTitle">How the work runs</h2>
        <ol class="svc__process" data-fx="group">
          <li><span>01</span><strong data-i18n="process.stepOneTitle">Diagnose</strong><span data-i18n="process.stepOneText">We clarify the audience, offer, current bottleneck, and what the first version must prove.</span></li>
          <li><span>02</span><strong data-i18n="process.stepTwoTitle">Shape</strong><span data-i18n="process.stepTwoText">We define messaging, structure, visual direction, UX flow, and the priority service path.</span></li>
          <li><span>03</span><strong data-i18n="process.stepThreeTitle">Build</strong><span data-i18n="process.stepThreeText">We design and develop the assets, pages, automations, or product screens needed for launch.</span></li>
          <li><span>04</span><strong data-i18n="process.stepFourTitle">Measure</strong><span data-i18n="process.stepFourText">We connect capture, follow-up, analytics, and iteration so the system can improve after launch.</span></li>
        </ol>
      </section>

      {#- The honest proof line for this specific service, or the honest
          absence of it. -#}
      <p class="svc__proofnote" data-fx="fade-up">{{ service.en.proofNote }}</p>

      {#- The questions a buyer asks about THIS service, which used to live
          only in the homepage FAQ. Each page emits its own FAQPage node from
          the same array it renders, so schema and page can never disagree. -#}
      <section class="svc__block" aria-labelledby="svc-faq">
        <h2 id="svc-faq" class="svc__block-title" data-fx="fade-up" data-i18n="servicePage.faqTitle">Questions</h2>
        <dl class="svc__faq" data-fx="group">
          {%- for item in service.en.faqs %}
          <div class="svc__faq-item">
            <dt>{{ item.q }}</dt>
            <dd>{{ item.a }}</dd>
          </div>
          {%- endfor %}
        </dl>
      </section>

      {%- set relCases = relations.byService[service.slug].cases %}
      {%- set relNotes = relations.byService[service.slug].notes %}
      {%- set relServices = [] %}
      {% include "related.njk" %}

      <section class="svc__cta" aria-labelledby="svc-cta" data-fx="fade-up">
        <h2 id="svc-cta" class="svc__cta-title" data-i18n="servicePage.ctaTitle">Start with a diagnosis, not a quote.</h2>
        <p class="svc__cta-text" data-i18n="servicePage.ctaText">Tell us the bottleneck. If this is not the right service for it, we will say so and point at the one that is.</p>
        <a class="hero__cta" href="/contact?service={{ service.slug }}" data-i18n="hero.primaryCta">Start a project</a>
      </section>

      <nav class="svc__siblings" aria-label="Other services">
        <h2 class="svc__block-title" data-i18n="servicesPage.othersTitle">The other five</h2>
        <ul>
          {%- for other in services %}{% if other.slug != service.slug %}
          <li><a href="/services/{{ other.slug }}/"><span>{{ "0" + (loop.index | string) }}</span>{{ other.en.title }}</a></li>
          {%- endif %}{% endfor %}
        </ul>
      </nav>
    </div>
