---
permalink: "/sitemap.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
{#- Built from the route tree plus the two paginated collections, so a new
    page cannot be forgotten — the hand-edited six-line file this replaces had
    already fallen behind the routes that existed. Paginated outputs are
    enumerated from their source data rather than collections.all, because a
    template that paginates contributes only its first output there. -#}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for item in collections.all %}
{#- The homepage is excluded here and declared as a pair below. It used to fall
    through this loop as a bare <loc> with no alternates, while /es/ was
    filtered out entirely by the "/es/" rule — so the site's two most important
    URLs were the only pair in the file that did not declare each other. -#}
{%- if item.url and item.url != "/" and not item.data.robots and "/services/" not in item.url and "/insights/" not in item.url and "/work/" not in item.url and "/es/" not in item.url and "/404" not in item.url %}
  <url><loc>{{ site.origin }}{{ item.url }}</loc></url>
{%- endif %}
{%- endfor %}
  <url><loc>{{ site.origin }}/work/</loc></url>
  <url>
    <loc>{{ site.origin }}/services/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.origin }}/services/"/>
    <xhtml:link rel="alternate" hreflang="es" href="{{ site.origin }}/es/servicios/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.origin }}/services/"/>
  </url>
  <url>
    <loc>{{ site.origin }}/es/servicios/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.origin }}/services/"/>
    <xhtml:link rel="alternate" hreflang="es" href="{{ site.origin }}/es/servicios/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.origin }}/services/"/>
  </url>
{#- Each locale pair is declared with xhtml:link alternates as well as in the
    page head. Google reads either, and a cluster is only honoured when the
    set is identical and bidirectional on every member — emitting both sides
    from this one loop is what guarantees that. -#}
{%- for service in services %}
  <url>
    <loc>{{ site.origin }}/services/{{ service.slug }}/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.origin }}/services/{{ service.slug }}/"/>
    <xhtml:link rel="alternate" hreflang="es" href="{{ site.origin }}/es/servicios/{{ service.esSlug }}/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.origin }}/services/{{ service.slug }}/"/>
  </url>
  <url>
    <loc>{{ site.origin }}/es/servicios/{{ service.esSlug }}/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.origin }}/services/{{ service.slug }}/"/>
    <xhtml:link rel="alternate" hreflang="es" href="{{ site.origin }}/es/servicios/{{ service.esSlug }}/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.origin }}/services/{{ service.slug }}/"/>
  </url>
{%- endfor %}
{#- Every locale pair below emits both sides with the same alternate set,
    for the same reason the service pairs do: a cluster whose members
    disagree is dropped whole. -#}
{%- macro pair(enPath, esPath) -%}
  <url>
    <loc>{{ site.origin }}{{ enPath }}</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.origin }}{{ enPath }}"/>
    <xhtml:link rel="alternate" hreflang="es" href="{{ site.origin }}{{ esPath }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.origin }}{{ enPath }}"/>
  </url>
  <url>
    <loc>{{ site.origin }}{{ esPath }}</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.origin }}{{ enPath }}"/>
    <xhtml:link rel="alternate" hreflang="es" href="{{ site.origin }}{{ esPath }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.origin }}{{ enPath }}"/>
  </url>
{%- endmacro -%}
{{ pair("/", "/es/") }}
{{ pair("/es/trabajo/" | replace("/es/trabajo/", "/work/"), "/es/trabajo/") }}
{%- for case in cases %}
{{ pair("/work/" + case.slug + "/", "/es/trabajo/" + case.esSlug + "/") }}
{%- endfor %}
{{ pair("/insights/", "/es/notas/") }}
{%- for note in notes %}
{{ pair("/insights/" + note.slug + "/", "/es/notas/" + note.esSlug + "/") }}
{%- endfor %}
{{ pair("/studio/", "/es/estudio/") }}
{{ pair("/lab/", "/es/lab/") }}
  <url><loc>{{ site.origin }}/contact</loc></url>
</urlset>
