---
pagination:
  data: cases
  size: 1
  alias: case
permalink: "/work/{{ case.slug }}/"
layout: "layout.njk"
subpage: true
lang: "en"
L: "en"
localePrefix: ""
eleventyComputed:
  title: "{{ case.en.title | safe }} | CREATIVE MK"
  description: "{{ case.en.challenge | truncate(155) }}"
  ogDescription: "{{ case.en.lead | safe }} — {{ case.en.client | safe }}."
  canonical: "/work/{{ case.slug }}/"
  altEs: "/es/trabajo/{{ case.esSlug }}/"
  ogImage: "/images/og/case-{{ case.slug }}.png"
  pageSchema:
    "@type": "CreativeWork"
    "@id": "https://creativemk.net/work/{{ case.slug }}/#case"
    name: "{{ case.en.title | safe }}"
    url: "https://creativemk.net/work/{{ case.slug }}/"
    abstract: "{{ case.en.challenge | truncate(200) }}"
    inLanguage: "en"
    dateCreated: "{{ case.year }}"
    creator:
      "@id": "https://creativemk.net/#studio"
---
{% include "case-body.njk" %}
